
alias lsa="ls -a"


# ------------
# prompt customization
PS1=" \[$(tput sgr0)\]\[\033[38;5;221m\]\W\[$(tput sgr0)\] \[$(tput sgr0)\]\]$(tput bold)\]\[\033[38;5;231m\]\\$\[$(tput sgr0)\] \[$(tput sgr0)\]"

# alternative prompt customization
#PS1="  \w $ "

# alternative prompt customization - uncommenting the following:
#source .bash_prompt_customization


# ------------
# ls colors

# optionally customize colors for listings by uncommenting the following:
#export LS_COLORS='di=1;34:ow=1;34:st=1;34:tw=1;34:fi=0:ln=1;36:ex=1;32'

